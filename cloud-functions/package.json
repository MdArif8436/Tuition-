{
  "name": "bca-tuition-cloud-functions",
  "version": "2.0.0",
  "description": "Server-side cloud functions for BCA Tuition & HOD Portal: Razorpay verification, transactional email, attendance QR tokens, and role security.",
  "main": "index.js",
  "scripts": {
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "18"
  },
  "dependencies": {
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^5.0.0",
    "crypto": "^1.0.1",
    "nodemailer": "^6.9.10"
  },
  "private": true
}
